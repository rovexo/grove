#!/usr/bin/env bash
#
# grove — per-worktree dev sites, and the public HTTPS zone they are served on.
#
# The public half — one wildcard per zone, one proxy block per project:
#   status     what is in place and what is not                                    (no root)
#   cert       issue or renew the zone's wildcard via DNS-01                       (no root)
#   publish    claim this project's host pattern in the proxy + renewal timer      (ONE sudo)
#   unpublish  give it back: matcher, registry row, and the zone if it was the last (no root)
#
# The worktree half — one isolated checkout, database and URL per session:
#   create list info shell provision sync-db merge remove prune-merged wire
#   hook create|remove|context|on-edit
#
# THE HOOKS ARE THE INTERFACE THAT MATTERS. An AI session never types `grove create`: Claude Code
# fires a WorktreeCreate hook, and the session is moved into a worktree and has to be told where it
# landed. The commands above are the human's copy of the same operations. See lib/hooks.sh.
#
# Everything project-specific comes from .grove.conf at the project root; this file contains no
# project names, zones or ports. See docs/PLAYBOOK.md for the design and the traps, and
# docs/CONCEPT-worktrees.md for why every path declares a strategy.
#
# Part of rovexo/grove.

set -uo pipefail

# Homebrew sets GROVE_PKG_DIR via the wrapper it installs in bin/; from a clone there is no
# wrapper, so fall back to resolving lib/ relative to this file.
case "${1:-}" in
	-h|--help|help)
		printf 'grove — per-worktree dev sites on real public HTTPS subdomains\n\n'
		printf 'Public hosting\n'
		printf '  grove status              what is in place and what is not      (no root)\n'
		printf '  grove cert                issue or renew the zone wildcard      (no root)\n'
		printf '  grove publish             put this project on the zone          (root only until\n'
		printf '                            the one-time setup that status prints)\n'
		printf '  grove unpublish           take this project off the zone        (no root)\n'
		printf '                            [--promote <project>] names who takes over the zone\n'
		printf '                            default when this project owns it\n'
		printf '  grove unpublish-zone      once the zone is empty: remove its    (no root, except one\n'
		printf '                            certificate store and renewal timer   sudo re-run if a\n'
		printf '                            [--force] ignores a stale registry    LaunchDaemon is installed)\n'
		printf '  sudo grove publish-timer  install the zone renewal timer         (root, once per zone)\n\n'
		printf 'Worktrees\n'
		printf '  grove create <name>       branch + worktree + site. No sudo, no prompts.\n'
		printf '  grove list                every worktree: branch, URL, database, idle time\n'
		printf '  grove info <name>         paths, URL, database, commits still to land\n'
		printf '  grove shell <name> [cmd]  run in that worktree, inside the container\n'
		printf '  grove provision <name>    give a site-less worktree its site after the fact\n'
		printf '  grove sync-db <name>      re-seed its database from the main one\n'
		printf '  grove merge <name> [--keep]   land the work; release it unless --keep\n'
		printf '  grove remove <name> [-f]  release without merging\n'
		printf '  grove prune-merged        delete worktree branches whose commits have all landed\n'
		printf '  grove wire                derive the vhost, hostnames and sync-ignore list\n\n'
		printf 'Hook entry points (wired into .claude/settings.json by `grove wire`)\n'
		printf '  grove hook create | remove | context | on-edit\n\n'
		printf 'Reads .grove.conf from this directory or any parent.\n'
		exit 0 ;;
	-V|--version) printf 'grove 0.2.7\n'; exit 0 ;;
esac

PKG_DIR="${GROVE_PKG_DIR:-$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || printf '%s' "${BASH_SOURCE[0]}")")/.." && pwd)}"
# shellcheck source=../lib/config.sh
. "$PKG_DIR/lib/config.sh"
# shellcheck source=../lib/worktree.sh
. "$PKG_DIR/lib/worktree.sh"     # also resolves MAIN_ROOT — the MAIN checkout, even from inside a worktree
# shellcheck source=../lib/hooks.sh
. "$PKG_DIR/lib/hooks.sh"


C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'; C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_OFF" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$C_RED" "$C_OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YEL" "$C_OFF" "$*"; }
die()  { printf '%serror:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

# The LAN address Caddy binds. Walk the active interfaces rather than assuming en0/en1 — a dock,
# a USB adapter or Wi-Fi-vs-Ethernet all move it, and an EMPTY answer here is dangerous rather than
# merely wrong: `bind` with no address makes Caddy listen on EVERY interface, which is the one thing
# this design is careful not to do. Callers must treat empty as fatal.
lan_ip() {
	local i ip
	for i in $(ifconfig -l 2>/dev/null); do
		case "$i" in lo*|awdl*|llw*|utun*|bridge*|gif*|stf*) continue ;; esac
		ip="$(ipconfig getifaddr "$i" 2>/dev/null)"
		[ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
	done
	return 1
}

# The address the Caddyfile was written with, so status can spot DHCP moving the machine underneath it.
caddyfile_bound_ip() {
	grove_caddy_cat | awk '/^'"${ZONE//./\\.}"'|^\*\.'"${ZONE//./\\.}"'/{f=1} f&&/^[[:space:]]*bind /{print $2; exit}' 2>/dev/null
}

# The Cloudflare token, from the gitignored secrets file. Never echoed, never committed.
load_token() {
	# The provider token, from the project's gitignored secrets file. Never echoed, never committed.
	# The variable NAME is configurable because each ACME DNS provider reads its own
	# (CLOUDFLARE_DNS_API_TOKEN, AWS_ACCESS_KEY_ID, DO_AUTH_TOKEN, …); lego picks it up from the
	# environment, so all this has to do is export it under the right name.
	local var value
	var="${GROVE_DNS_TOKEN_VAR:-CLOUDFLARE_DNS_API_TOKEN}"

	[ -f "$SECRETS" ] || die "no secrets file at $SECRETS"

	value="$(grep -E "^${var}=" "$SECRETS" | head -1 | cut -d= -f2- | tr -d "\"' ")"
	[ -n "$value" ] || die "$var is not set in $SECRETS
       Create a token scoped to the $ZONE zone and add:
         $var=\"...\""

	export "$var=$value"
}

# Every external command this tool shells out to, checked up front with a message that says what
# to install. Without this the failures are indirect and misleading: a missing `dig` makes the DNS
# check report "does NOT resolve" for a zone that resolves fine, and a missing `caddy` gets as far
# as EDITING the proxy config before failing to validate it.
require_tools() { # <tool:hint> ...
	local missing=0 spec name hint
	for spec in "$@"; do
		name="${spec%%:*}"; hint="${spec#*:}"
		command -v "$name" >/dev/null 2>&1 || { bad "$name is not installed — $hint"; missing=1; }
	done
	[ "$missing" -eq 0 ] || die "install the tools above and try again"
}

cmd_status() {
	grove_require_public
	require_tools "dig:part of bind-tools (brew install bind)" "openssl:check your PATH"

	printf '\n  %sPublic hosting — %s%s\n\n' "$C_BOLD" "$ZONE" "$C_OFF"

	local ip; ip="$(lan_ip)"
	printf '  %-14s %s\n' "LAN IP" "${ip:-unknown}"
	printf '  %-14s %s\n' "Upstream" "127.0.0.1:${UPSTREAM_PORT}"

	# DNS: the wildcard is the only record that matters — and WHERE it points matters as much as
	# whether it resolves.
	#
	# A home connection's WAN address moves. When it does, the record goes on resolving perfectly to
	# an address that is no longer yours, and every public URL for the zone dies from the outside
	# while everything on this machine still looks healthy: the certificate is valid, Caddy is
	# serving, the local names work. It is a silent, total outage that presents as nothing at all.
	# (Found exactly that way: a zone had been pointing at a stale address for some time, and only a
	# second zone being set up alongside it made the mismatch visible.)
	local resolved wan
	resolved="$(dig +short A "probe-$$.${ZONE}" | tail -1)"
	if [ -z "$resolved" ]; then
		bad "DNS  *.${ZONE} does NOT resolve — add:  *.${ZONE}  A  <public IP>"
	else
		# Best-effort and never fatal: no network, or a service being down, must not turn a healthy
		# report red. Silence here means "could not check", which is why it says so.
		wan="$(curl -s --max-time 4 https://api.ipify.org 2>/dev/null)"
		case "$wan" in
		''|*[!0-9.]*) ok "DNS  *.${ZONE} resolves to $resolved (public IP unknown — not compared)" ;;
		"$resolved")  ok "DNS  *.${ZONE} resolves to $resolved, which is this connection" ;;
		*)
			bad "DNS  *.${ZONE} points at $resolved but this connection is $wan"
			warn "every public URL on this zone is dead from the outside until the record is updated"
			warn "a dynamic WAN address will do this again — a static IP or a dynamic-DNS updater is the fix"
			;;
		esac
	fi

	# The pinned upstream port has to exist or Caddy proxies into nothing.
	if grep -qs "host_https_port" "$MAIN_ROOT/.ddev/config.local.yaml" 2>/dev/null; then
		ok "ddev  host_https_port pinned"
	else
		bad "ddev  host_https_port not pinned — add  host_https_port: \"${UPSTREAM_PORT}\"  to .ddev/config.local.yaml and restart"
	fi

	if [ -f "$CRT" ]; then
		local end; end="$(openssl x509 -enddate -noout -in "$CRT" 2>/dev/null | cut -d= -f2)"
		ok "cert  present, expires $end"
	else
		bad "cert  missing — run: grove cert"
	fi

	if grove_caddy_cat | grep -q "$ZONE"; then
		# The zone block existing is not the same as THIS project being routed by it. A second
		# project on an established zone sees the block already there and must still claim its
		# hosts, so report the two facts separately.
		local mine="no"
		grove_caddy_cat | grep -q -- "$HOST_FIRST" && mine="matcher"
		[ "$(caddyfile_default_port)" = "$UPSTREAM_PORT" ] && mine="default upstream"

		local bound; bound="$(caddyfile_bound_ip)"
		if [ -n "$bound" ] && [ -n "$ip" ] && [ "$bound" != "$ip" ]; then
			# DHCP moved the machine. Caddy is still bound to (or failing to bind) the old address
			# and the router's forward points at it — a total outage that looks like a DNS problem.
			bad "caddy bound to $bound but this machine is $ip — re-run: sudo grove publish"
			warn "give this machine a DHCP reservation so it stops moving"
		else
			# A project that claims a matcher claims CONCRETE slot hostnames, so raising GROVE_SLOTS
			# without re-publishing leaves the new ones unclaimed — and an unclaimed name under the
			# zone is served by whichever project owns the zone's default upstream. That is a 200
			# with a different project's site, which is the least debuggable outcome available.
			if [ "$mine" = "matcher" ]; then
				local claimed
				claimed="$(grove_caddy_cat | grep -oE "wt[0-9]+-${PROJECT}\.${ZONE//./\\.}" | sort -u | wc -l | tr -d ' ')"
				if [ "${claimed:-0}" -lt "${GROVE_SLOTS:-5}" ]; then
					bad "only $claimed of ${GROVE_SLOTS:-5} slots are claimed in the proxy — run: grove publish"
					warn "wt$((claimed + 1))…wt${GROVE_SLOTS:-5} would answer with whichever project owns the zone default"
				fi
			fi

			if [ "$mine" = "no" ]; then
				bad "caddy $ZONE block exists but does NOT route $PROJECT — run: $(rootless_ready && printf 'grove publish' || printf 'sudo grove publish')"
			else
				ok "caddy routes $PROJECT ($mine)${bound:+, bound to $bound}"
			fi
		fi
	else
		bad "caddy site block missing — run: $(rootless_ready && printf 'grove publish' || printf 'sudo grove publish')"
	fi

	local others; others="$(zone_projects)"
	[ -n "$others" ] && printf '  %-14s %s\n' "on this zone" "$others"

	if rootless_ready; then
		ok "rootless — site blocks in $SITES_DIR, applied over the admin API"
	elif caddy_imports_sites; then
		bad "the import is in place but the admin API is off — reloads still need root"
	else
		bad "privileged mode — every change needs sudo"
	fi

	# A timer that exists is not a timer that works. It fires nightly into a script, and if that
	# script calls a binary that has since moved there is no error anyone sees — the certificate just
	# stops renewing and expires months later. So check the whole chain, not the plist.
	if [ -f "$DAEMON_PLIST" ]; then
		local renew_bin
		renew_bin="$(grep -m1 '^GROVE=' "$RENEW_SCRIPT" 2>/dev/null | cut -d'"' -f2)"
		if [ ! -f "$RENEW_SCRIPT" ]; then
			bad "renewal timer installed but its script is missing — run: grove publish-timer"
		elif [ -n "$renew_bin" ] && [ ! -x "$renew_bin" ]; then
			bad "renewal timer calls $renew_bin, which is not executable — run: grove publish-timer"
			warn "left alone this renews nothing and the certificate expires with no warning"
		else
			ok "renewal timer installed (zone-wide), calling ${renew_bin:-the renewal script}"
		fi
	else
		bad "renewal timer missing — run once: sudo grove publish-timer"
	fi

	if ! rootless_ready; then
		printf '\n'
		rootless_setup_hint
	fi

	printf '\n  Try:  curl -sI https://wt1-%s.%s/ | head -1\n\n' "$PROJECT" "$ZONE"
}

# Issue or renew — one command for both.
#
# lego 5 changed its CLI in two ways that matter: the flags belong to the SUBCOMMAND (`lego run
# --email …`, not `lego --email … run`), and the separate `renew` command is gone — `run` is
# documented as "Get or renew a certificate" and decides for itself, so this is safe to call from a
# daily timer and is a no-op until renewal is actually due.
cmd_cert() {
	grove_require_public
	require_tools "lego:brew install lego" "openssl:should be present on macOS; check your PATH"
	load_token
	mkdir -p "$LEGO_DIR" "$CERT_DIR/certs"

	echo "==> lego run (issues, or renews when due)"
	# --dns.resolvers is not optional here. lego verifies TXT propagation through the SYSTEM
	# resolvers, and this machine's include an ISP IPv6 recursor ([2a0c:5a80:0:2::1]) that never
	# returned the record — issuance then failed with "time limit exceeded" long after Cloudflare
	# had published it. Asking public resolvers directly checks the same fact without depending on
	# whatever DHCP handed us, which is what makes this safe to run unattended.
	lego run \
		--email "$ACME_EMAIL" \
		--dns "$DNS_PROVIDER" \
		--dns.resolvers "1.1.1.1:53,8.8.8.8:53" \
		--accept-tos \
		--path "$LEGO_DIR" \
		--domains "*.${ZONE}" \
		--domains "${ZONE}" || die "lego run failed"

	# Copy to a stable path Caddy points at, so a renewal never needs a config change. Globbed
	# rather than assuming lego's file naming for a wildcard (it writes `_.zone.crt`).
	local crt key
	crt="$(ls -1 "$LEGO_DIR"/certificates/*."${ZONE}".crt 2>/dev/null | head -1)"
	key="$(ls -1 "$LEGO_DIR"/certificates/*."${ZONE}".key 2>/dev/null | head -1)"
	[ -n "$crt" ] && [ -n "$key" ] || die "lego reported success but no certificate landed in $LEGO_DIR/certificates"

	cp "$crt" "$CRT"
	cp "$key" "$KEY"
	chmod 644 "$CRT"; chmod 640 "$KEY"
	ok "certificate at $CRT"
}

# The unprivileged path: our own file in our own directory, then a reload over the admin API.
#
# Rollback is trivial and total here, which is why the pre-flight can be "write then check": the
# ONLY thing that changed is one file we own, so removing it (or restoring its previous version)
# puts the machine back exactly. And nothing has been applied yet — the running Caddy is untouched
# until the reload at the end.
cmd_install_rootless() {
	local ip; ip="$(lan_ip)" || die "could not determine this machine's LAN address"
	[ -n "$ip" ] || die "could not determine this machine's LAN address"

	mkdir -p "$SITES_DIR" || die "could not create $SITES_DIR"

	# One file per zone. An install from before that rule keeps the zone's block under whichever
	# PROJECT first wrote it — which is usually not this one, so the search is by content rather than
	# by name: find the file that actually defines this zone and give it the zone's name.
	if [ ! -f "$ZONE_SITE_FILE" ]; then
		local f owner=""
		for f in "$SITES_DIR"/*.caddy; do
			[ -f "$f" ] || continue
			grep -qE "^${ZONE//./\\.}(,|[[:space:]])" "$f" && { owner="$f"; break; }
		done
		if [ -n "$owner" ]; then
			mv "$owner" "$ZONE_SITE_FILE" \
				&& ok "moved $(basename "$owner") to $(basename "$ZONE_SITE_FILE") — one file per zone, shared by every project on it"
		fi
	fi

	local had_before=0 backup=""
	if [ -f "$SITE_FILE" ]; then
		had_before=1
		backup="$(mktemp)"; cp "$SITE_FILE" "$backup"
	fi

	# WHOEVER GETS HERE FIRST owns the zone's default upstream; everyone after claims a host matcher
	# INSIDE that same block. A matcher rather than a block of their own, because Caddy permits one
	# definition per site and will not accept `*-project.zone` as a site address at all.
	if [ ! -f "$SITE_FILE" ]; then
		zone_block "$ip" > "$SITE_FILE"
	elif [ "$(caddyfile_default_port)" = "$UPSTREAM_PORT" ]; then
		ok "$PROJECT is already the default upstream for $ZONE — no matcher needed"
	else
		# Any previous block of OURS is stripped before the new one goes in, so publish is idempotent
		# AND applies changes. Skipping when the project was already present looked harmless and was
		# not: a raised GROVE_SLOTS then never reached the proxy, leaving the new slots unclaimed and
		# answered by whichever project owns the zone default.
		if grep -q -- "# $PROJECT — added by grove" "$SITE_FILE"; then
			local stripped; stripped="$(mktemp)"
			strip_matcher "$SITE_FILE" "$PROJECT" > "$stripped"
			cat "$stripped" > "$SITE_FILE"
			rm -f "$stripped"
		fi
		# Anchored on the ZONE's own tls line: anchoring on the first tls in the file would drop the
		# matcher into a different project's block.
		local staged_site; staged_site="$(mktemp)"
		awk -v z="^${ZONE//./\\.}[ ,]" -v pat="$(grove_host_list)" -v port="$UPSTREAM_PORT" \
		    -v proj="$PROJECT" -v scheme="$UPSTREAM_SCHEME" '
			{ print }
			$0 ~ z { inz = 1 }
			inz && !done && /^[[:space:]]*tls / {
				print ""
				print "\t# " proj " — added by grove"
				print "\t@" proj " host " pat
				print "\treverse_proxy @" proj " " scheme "://127.0.0.1:" port " {"
				print "\t\theader_up Host {host}"
				print "\t\theader_up X-Forwarded-Proto https"
				print "\t\ttransport http {"
				print "\t\t\ttls"
				print "\t\t\ttls_insecure_skip_verify"
				print "\t\t}"
				print "\t}"
				done = 1
			}
		' "$SITE_FILE" > "$staged_site"
		cat "$staged_site" > "$SITE_FILE"
		rm -f "$staged_site"
	fi

	if ! caddy adapt --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
		if [ "$had_before" -eq 1 ]; then cp "$backup" "$SITE_FILE"; else rm -f "$SITE_FILE"; fi
		rm -f "$backup"
		die "the generated block does not parse — reverted, and nothing was applied"
	fi
	rm -f "$backup"
	ok "wrote $SITE_FILE and the combined config parses"

	zone_register "$PROJECT" "$UPSTREAM_PORT" "$HOST_PATTERN"

	if caddy reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
		ok "Caddy reloaded over the admin API — no root, no restart, no downtime"
	else
		warn "reload failed; the file is in place and will apply on the next reload"
	fi

	if [ -f "$DAEMON_PLIST" ] && launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
		ok "renewal timer for $ZONE already running"
	else
		warn "renewal timer not installed — that one step still needs: sudo grove publish-timer"
	fi
}

# A standalone matcher block, for a project joining a zone another project already serves as the
# default. Same shape the in-place editor inserts, but as its own importable file.
matcher_snippet() {
	cat <<EOF
# $PROJECT — added by grove. Claims its hosts inside the $ZONE block.
$HOST_PATTERN {
	bind $(lan_ip)
$([ "$NOINDEX" = "1" ] && printf '\theader X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"\n')
	tls $CRT $KEY

	reverse_proxy ${UPSTREAM_SCHEME}://127.0.0.1:$UPSTREAM_PORT {
		header_up Host {host}
		header_up X-Forwarded-Proto https

		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
EOF
}

cmd_install() {
	grove_require_public
	require_tools "caddy:brew install caddy" "curl:check your PATH"
	[ -f "$CRT" ] || die "no certificate yet — run:  grove cert"

	# Preferred: no root at all. Falls through to the privileged path on a machine that has not had
	# the one-time setup, so nothing breaks for existing installs.
	if rootless_ready; then
		cmd_install_rootless
		return
	fi

	[ "$(id -u)" -eq 0 ] || die "this machine still needs the privileged path — either run with sudo, or do the one-time setup that removes it (see: grove status)"
	require_tools "caddy:brew install caddy" "awk:check your PATH" "launchctl:macOS only — no systemd support"
	[ -f "$CRT" ] || die "no certificate yet — run (as yourself):  grove cert"

	local ip
	ip="$(lan_ip)" || die "could not determine this machine's LAN address — refusing to write a config that would bind ALL interfaces"
	[ -n "$ip" ] || die "could not determine this machine's LAN address — refusing to write a config that would bind ALL interfaces"

	# EVERYTHING IS STAGED. The Caddyfile is shared with any other project on this machine, so it is
	# never edited in place: the new content is built in a temp file, adapted by Caddy, and only
	# copied over the real one once it parses. Writing first and validating afterwards is exactly how
	# a broken block reached a live proxy — it kept serving from memory, so nothing looked wrong until
	# the next restart would have failed to come up at all.
	local staged; staged="$(mktemp)" || die "could not create a temp file"
	local changed=0
	# shellcheck disable=SC2064
	trap "rm -f '$staged' '$staged.adapt'" RETURN

	if [ ! -f "$CADDYFILE" ]; then
		# BOOTSTRAP: nothing on this machine serves the zone yet. Write a whole config and the daemon
		# that runs it, rather than requiring someone to have set Caddy up by hand first.
		mkdir -p "$(dirname "$CADDYFILE")" || die "could not create $(dirname "$CADDYFILE")"
		{
			printf '# Generated by grove. Shared by every project on this machine.\n'
			printf '{\n\temail %s\n\tadmin off\n}\n' "$ACME_EMAIL"
			zone_block "$ip"
		} > "$staged"
		changed=1
		note_bootstrap=1
	elif grep -q "$HOST_FIRST" "$CADDYFILE"; then
		warn "$PROJECT already claims $HOST_PATTERN — leaving the Caddyfile alone"
		cp "$CADDYFILE" "$staged"
	elif [ "$(caddyfile_default_port)" = "$UPSTREAM_PORT" ]; then
		ok "$PROJECT is already the default upstream for $ZONE — no matcher needed"
		cp "$CADDYFILE" "$staged"
	elif grep -qE "^[^#]*\*\.${ZONE//./\\.}" "$CADDYFILE"; then
		# Another project owns this zone's block. Caddy refuses two blocks claiming the same wildcard,
		# so claim a host matcher inside the existing one — anchored on the ZONE's own tls line, since
		# anchoring on the first tls in the file put the matcher in a different project's block.
		awk -v z="^${ZONE//./\\.}[ ,]" -v pat="$(grove_host_list)" -v port="$UPSTREAM_PORT" \
		    -v proj="$PROJECT" -v scheme="$UPSTREAM_SCHEME" '
			{ print }
			$0 ~ z { inz = 1 }
			inz && !done && /^[[:space:]]*tls / {
				print ""
				print "\t# " proj " — added by grove"
				print "\t@" proj " host " pat
				print "\treverse_proxy @" proj " " scheme "://127.0.0.1:" port " {"
				print "\t\theader_up Host {host}"
				print "\t\theader_up X-Forwarded-Proto https"
				print "\t\ttransport http {"
				print "\t\t\ttls"
				print "\t\t\ttls_insecure_skip_verify"
				print "\t\t}"
				print "\t}"
				done = 1
			}
		' "$CADDYFILE" > "$staged"
		changed=1
	else
		# A Caddyfile exists but nothing serves this zone: append the block.
		{ cat "$CADDYFILE"; printf '\n'; zone_block "$ip"; } > "$staged"
		changed=1
	fi

	# THE PRE-FLIGHT. Adapt (parse) the staged config before it goes anywhere near the real one.
	# `adapt` is the right check here rather than `validate`: validate also provisions the TLS app,
	# which fails on another project's key that only root-at-runtime can read, so it cannot tell a
	# syntax error apart from a permissions artifact.
	if [ "$changed" -eq 1 ]; then
		caddy adapt --config "$staged" --adapter caddyfile >/dev/null 2>"$staged.adapt" || {
			printf '%s\n' "$(tail -3 "$staged.adapt")" >&2
			die "the generated config does not parse — the real Caddyfile is UNTOUCHED"
		}
		ok "generated config parses"

		[ -f "$CADDYFILE" ] && cp "$CADDYFILE" "${CADDYFILE}.bak-$(date +%Y%m%d-%H%M%S)"
		cat "$staged" > "$CADDYFILE"
		chmod 644 "$CADDYFILE"
		if [ "${note_bootstrap:-0}" = "1" ]; then
			ok "wrote a new Caddyfile at $CADDYFILE"
			install_caddy_daemon
		else
			ok "claimed $HOST_PATTERN in $CADDYFILE (backup kept alongside)"
		fi
	fi

	# CENTRAL, PER ZONE: one certificate, one ACME account, one timer, shared by every project under
	# the wildcard. A second project registers itself and finds the timer already running.
	zone_register "$PROJECT" "$UPSTREAM_PORT" "$HOST_PATTERN"

	if [ -f "$DAEMON_PLIST" ] && launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
		ok "renewal timer for $ZONE already running"
	else
		install_renew_timer
	fi

	apply_caddy "$changed"
}

# The zone's site block, with this project as the default upstream. Used by bootstrap and by the
# append path; the matcher path edits an existing one instead.
zone_block() { # <lan-ip>
	cat <<EOF
# $ZONE — added by grove for $PROJECT. Every name under the zone is proxied to a
# project's stack; each stack's web server routes by Host, so adding a WORKTREE needs no change
# here and no sudo. Adding a PROJECT adds a matcher above this default.
$ZONE, *.$ZONE {
	bind $1
$([ "$NOINDEX" = "1" ] && printf '\theader X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"\n')
	tls $CRT $KEY

	reverse_proxy ${UPSTREAM_SCHEME}://127.0.0.1:$UPSTREAM_PORT {
		# Both load-bearing: without Host the app builds links to 127.0.0.1, without
		# X-Forwarded-Proto it emits http:// and redirect-loops.
		header_up Host {host}
		header_up X-Forwarded-Proto https

		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
EOF
}

# Bootstrap only: the LaunchDaemon that runs Caddy itself. Skipped when one already exists, because
# on a machine that already had Caddy it is not ours to replace.
install_caddy_daemon() {
	if [ -f "$CADDY_PLIST" ]; then
		ok "Caddy daemon already installed ($CADDY_LABEL)"
		return 0
	fi
	local bin; bin="$(command -v caddy)"
	cat >"$CADDY_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${CADDY_LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>${bin}</string><string>run</string>
    <string>--config</string><string>${CADDYFILE}</string>
    <string>--adapter</string><string>caddyfile</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/${CADDY_LABEL}.log</string>
  <key>StandardErrorPath</key><string>/var/log/${CADDY_LABEL}.log</string>
</dict></plist>
EOF
	chmod 644 "$CADDY_PLIST"
	launchctl bootstrap system "$CADDY_PLIST" 2>/dev/null || true
	ok "installed the Caddy daemon ($CADDY_LABEL)"
}

# Where this grove actually is. The renewal script runs from a LaunchDaemon with a minimal PATH, so
# it needs an absolute path — and it must be THIS grove, not a guess.
#
# It used to be a guess: "$MAIN_ROOT/grove", from when the tool was a script inside the project. Once
# grove became an installed binary that path stopped existing, and the failure is the worst shape
# there is — the timer fires nightly, the command is not found, the log records it, and NOTHING else
# happens. The certificate simply stops renewing and expires months later with no warning anywhere.
grove_binary() {
	local self="${BASH_SOURCE[0]}"
	case "$self" in /*) ;; *) self="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")" ;; esac
	# Prefer the wrapper on PATH: through Homebrew that is a stable symlink, whereas this file is the
	# versioned Cellar copy that an upgrade moves out from under us.
	command -v grove 2>/dev/null || printf '%s' "$self"
}

# The renewal script alone — user-owned, so writing it needs no root. Split out from the daemon
# precisely so a script gone stale can be repaired without one.
write_renew_script() {
	mkdir -p "$CERT_DIR" 2>/dev/null
	# REPLACED, not overwritten. When `sudo grove publish-timer` first installs it the file ends up
	# owned by root inside a directory owned by you — so a later unprivileged repair cannot write
	# THROUGH it, but can perfectly well unlink it and put a new one there (removing a file needs the
	# write bit on the directory, not on the file). Without this, repair fails with "Permission
	# denied" for no reason a reader could be expected to guess.
	rm -f "$RENEW_SCRIPT" 2>/dev/null
	cat >"$RENEW_SCRIPT" <<EOF
#!/bin/bash
# Installed by grove. Renews the ${ZONE} wildcard and applies it.
#
# Absolute paths throughout: a LaunchDaemon gets a minimal PATH, so bare \`caddy\`/\`launchctl\`
# are not on it.
#
# And it RESTARTS Caddy rather than reloading it — this Caddy runs with \`admin off\`, so
# \`caddy reload\` dies on "connection refused". Getting that wrong is the worst kind of bug here:
# renewal would fetch a fresh certificate every 90 days and silently never serve it, surfacing as
# an expired-certificate outage months later.
set -uo pipefail
LOG="$CERT_DIR/renew.log"
echo "=== \$(date '+%F %T') renew run ===" >>"\$LOG"

BEFORE=\$(/usr/bin/openssl x509 -noout -enddate -in "$CRT" 2>/dev/null || echo none)
# GROVE_USER is passed explicitly: this is root running sudo, so SUDO_USER inside the
# child is "root", and anything inferring the user from it would write the renewed certificate
# into /var/root while Caddy went on serving the old path.
# GROVE_PROJECT_ROOT is not optional: a LaunchDaemon starts in / , and grove finds its zone, its
# ACME contact and its DNS token by walking UP from the working directory to a .grove.conf. Without
# it the renewal cannot even tell which zone it is for.
GROVE="$(grove_binary)"
if [ ! -x "\$GROVE" ]; then
	echo "FATAL: \$GROVE is not executable — renewal cannot run. Re-run: grove publish-timer" >>"\$LOG"
	exit 1
fi
/usr/bin/sudo -u "${REAL_USER}" GROVE_USER="${REAL_USER}" GROVE_PROJECT_ROOT="$MAIN_ROOT" "\$GROVE" cert >>"\$LOG" 2>&1
AFTER=\$(/usr/bin/openssl x509 -noout -enddate -in "$CRT" 2>/dev/null || echo none)

# Only bounce Caddy when the certificate actually changed — a daily no-op must not restart the
# machine's only TLS front end (and every other project on it) 365 times a year.
if [ "\$BEFORE" != "\$AFTER" ]; then
	echo "certificate changed (\$BEFORE -> \$AFTER); restarting Caddy" >>"\$LOG"
	/bin/launchctl bootout "system/${CADDY_LABEL}" >>"\$LOG" 2>&1 || true
	waited=0
	while /bin/launchctl print "system/${CADDY_LABEL}" >/dev/null 2>&1 && [ "\$waited" -lt 30 ]; do
		sleep 1; waited=\$((waited + 1))
	done
	/bin/launchctl bootstrap system "$CADDY_PLIST" >>"\$LOG" 2>&1 || true
else
	echo "certificate unchanged; nothing to apply" >>"\$LOG"
fi
EOF
	# Checked, because a script that failed to write is indistinguishable from one that worked until
	# the certificate quietly expires. An earlier version reported success over a failed write.
	[ -s "$RENEW_SCRIPT" ] || return 1
	chmod 755 "$RENEW_SCRIPT"
	# Hand it back to the user when root wrote it, so the next repair needs no root at all.
	[ "$(id -u)" -eq 0 ] && chown "$REAL_USER" "$RENEW_SCRIPT" 2>/dev/null
	return 0
}

install_renew_timer() {
	write_renew_script

	cat >"$DAEMON_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${DAEMON_LABEL}</string>
  <key>ProgramArguments</key><array><string>${RENEW_SCRIPT}</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>17</integer></dict>
  <key>RunAtLoad</key><false/>
</dict></plist>
EOF
	launchctl bootout system "$DAEMON_PLIST" 2>/dev/null || true
	launchctl bootstrap system "$DAEMON_PLIST" || warn "launchctl bootstrap failed — load it by hand"
	ok "daily renewal timer installed (${DAEMON_LABEL})"

	# NOT `caddy reload`. That posts to the admin API, and this Caddy runs with `admin off` — the
	# reload dies on "connect: connection refused" while the new config sits unapplied on disk.
	# The daemon has to be restarted instead, which is what a proxy with `admin off` requires.
}

# Validate, then apply — but only bounce the proxy when its config actually changed. A daily or
# repeated run must not take the machine's only TLS front end, and every other project with it,
# down for nothing.
apply_caddy() {
	local changed="${1:-1}"
	caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 \
		|| die "Caddy rejected the config — restore the backup next to $CADDYFILE"
	ok "configuration valid"

	# Only bounce Caddy when its config actually changed. Re-running install to refresh the renewal
	# script must not take the machine's only TLS front end — and every other project on it — down.
	if [ "$changed" -eq 0 ]; then
		ok "Caddy config unchanged — not restarting"
		return 0
	fi

	if launchctl print "system/${CADDY_LABEL}" >/dev/null 2>&1; then
		launchctl bootout "system/${CADDY_LABEL}" 2>/dev/null || true
		# bootout returns before the job is gone; bootstrapping into that gap fails with
		# "Bootstrap failed: 5: Input/output error" and leaves NOTHING running. Wait it out.
		local waited=0
		while launchctl print "system/${CADDY_LABEL}" >/dev/null 2>&1 && [ "$waited" -lt 30 ]; do
			sleep 1; waited=$((waited + 1))
		done
	fi
	launchctl bootstrap system "$CADDY_PLIST" 2>/dev/null || true

	sleep 2
	if launchctl print "system/${CADDY_LABEL}" >/dev/null 2>&1; then
		ok "Caddy restarted — every project on it comes back with it"
	else
		die "Caddy did not come back. Restore the backup next to $CADDYFILE and bootstrap $CADDY_PLIST"
	fi
}

# --- unpublish: the inverse of publish -----------------------------------------------------------
#
# NOT "publish with the sign flipped". The zone block is SHARED by every project on the zone, so what
# has to happen depends on what this project is inside it: a host matcher, which is deleted, or the
# DEFAULT UPSTREAM every unclaimed name falls through to — which cannot simply be deleted, because a
# zone block with matchers and no default answers every other name with a 404 from Caddy itself.
#
# The order below is load-bearing and is the reason this command exists at all: doing it by hand on a
# live zone means editing a shared config, remembering the registry, reloading, and then a launchd
# teardown whose two steps only work one way round.

# The file that actually defines this zone's site block. Searched by CONTENT, never by name: a
# pre-0.2.5 install keeps the block under whichever PROJECT wrote it first, and a privileged install
# keeps it in the machine's Caddyfile rather than in a site file at all.
zone_block_file() {
	local f
	for f in "$SITE_FILE" "$SITES_DIR"/*.caddy "$CADDYFILE"; do
		[ -f "$f" ] || continue
		grep -qE "^${ZONE//./\\.}(,|[[:space:]])" "$f" && { printf '%s\n' "$f"; return 0; }
	done
	return 1
}

# Every project owning a matcher inside the zone block, one per line. The project that owns the
# DEFAULT upstream is deliberately not among them — it has no tag, which is what makes it the default.
zone_matchers() { # <zone-file>
	awk '
		/^\t# .* — added by grove$/ {
			line = $0
			sub(/^\t# /, "", line)
			sub(/ — added by grove$/, "", line)
			print line
		}
	' "$1" 2>/dev/null
}

# Delete a project's matcher block from a zone file (to stdout), along with the blank line that
# separated it from whatever is above. Shared with publish, which strips its own block before
# rewriting it — the two must agree on what a block is, or one of them leaves half of it behind.
#
# The "# " in the tag is what keeps `shop` from matching `web-shop`.
strip_matcher() { # <file> <project>
	awk -v tag="# $2 — added by grove" '
		function flush(   i) { for (i = 0; i < held; i++) print ""; held = 0 }
		skipping && /^\t\}$/ { skipping = 0; next }
		skipping { next }
		index($0, tag) { held = 0; skipping = 1; next }
		/^[[:space:]]*$/ { held++; next }
		{ flush(); print }
		END { flush() }
	' "$1"
}

# Delete the whole zone block — its site-address line through the closing brace at column 0 — plus
# grove's own header comment above it (to stdout).
strip_zone_block() { # <file>
	awk -v zre="^${ZONE//./\\.}[ ,{]" '
		function flush(   i) { for (i = 0; i < n; i++) print held[i]; n = 0 }
		del && /^\}/ { del = 0; next }
		del { next }
		$0 ~ zre { n = 0; del = 1; next }
		/^[[:space:]]*$/ || /^#/ { held[n++] = $0; next }
		{ flush(); print }
		END { flush() }
	' "$1"
}

# A project's matcher block, rewritten as a plain default upstream: the host matcher line goes, and
# the `@name` comes off its reverse_proxy.
#
# MOVED, never regenerated from a template. The registry knows a project's port and nothing else, so
# a regenerated block would guess at the scheme, the headers and the transport — and guess wrong for
# any project that is not on the defaults.
matcher_as_default() { # <file> <project>
	awk -v tag="# $2 — added by grove" -v proj="$2" '
		index($0, tag) { inb = 1; print "\t# " proj " — the zone default, promoted by grove unpublish"; next }
		inb {
			if ($0 ~ "^\t@" proj " host ") next
			line = $0
			sub("reverse_proxy @" proj " ", "reverse_proxy ", line)
			print line
			if ($0 ~ /^\t\}$/) inb = 0
		}
	' "$1"
}

# Drop the zone's current default reverse_proxy and put the promoted one at the END of the block.
#
# THE END IS THE WHOLE POINT. A reverse_proxy with no matcher matches every request and is terminal,
# so a promoted default sitting above another project's matcher would swallow that project's traffic
# entirely — a 200 serving the wrong project's site, which is the exact failure 0.2.5 was about.
#
# The promoted block is passed as a FILE and read with getline: `awk -v` cannot carry an embedded
# newline (it aborts with "newline in string"), which is how the sync-ignore splice broke in 0.2.4.
swap_default() { # <file> <promoted-block-file>
	awk -v zre="^${ZONE//./\\.}[ ,{]" -v nf="$2" '
		function flush(   i) { for (i = 0; i < n; i++) print held[i]; n = 0 }
		$0 ~ zre { inz = 1; flush(); print; next }
		# A default written WITHOUT a block — `reverse_proxy 127.0.0.1:8080` on its own line — is one
		# line, not a region. Skipping to the next `\t}` in that case would eat every remaining line of
		# the zone block, closing brace included.
		inz && /^\treverse_proxy [^@]/ { n = 0; if ($0 ~ /\{[[:space:]]*$/) del = 1; next }
		del && /^\t\}$/ { del = 0; next }
		del { next }
		inz && /^\}/ {
			n = 0
			print ""
			while ((getline l < nf) > 0) print l
			print
			inz = 0
			next
		}
		/^[[:space:]]*$/ { held[n++] = $0; next }
		{ flush(); print }
		END { flush() }
	' "$1"
}

# Put an edited zone file in place and check that the COMBINED config still parses, reverting if it
# does not. Same shape as publish and for the same reason: the file is what the Caddyfile imports, so
# it has to be on disk to be checked at all — and a config that does not parse must never reach the
# live proxy. The only thing that changed is one file we have a copy of, so the revert is total.
apply_zone_edit() { # <zone-file> <new-content-file>
	local zf="$1" new="$2" backup removed=0
	backup="$(mktemp)" || die "could not create a temp file"
	cp "$zf" "$backup"

	# The machine's Caddyfile is shared with every other project on it and is not ours to lose, so a
	# dated copy stays behind — the same one publish leaves when it edits that file.
	[ "$zf" = "$CADDYFILE" ] && cp "$CADDYFILE" "${CADDYFILE}.bak-$(date +%Y%m%d-%H%M%S)"

	# A site file with nothing left in it but comments and blank lines is removed rather than kept as
	# a stub — an import glob that matches no file is a warning, not an error. The machine's Caddyfile
	# is never removed: it holds the global options and the imports.
	#
	# Permission is checked BEFORE the write, not after. A rootless machine whose zone block is still
	# in the root-owned Caddyfile (an install that switched over later) would otherwise fail the write
	# silently, and `adapt` would then happily parse the config that never changed — reporting success
	# for a project that is still routed.
	if [ "$zf" != "$CADDYFILE" ] && ! grep -qvE '^[[:space:]]*(#.*)?$' "$new"; then
		[ -w "$(dirname "$zf")" ] || { rm -f "$backup"; die "$(dirname "$zf") is not writable by $(id -un) — run: sudo grove unpublish"; }
		rm -f "$zf" && removed=1
	else
		[ -w "$zf" ] || { rm -f "$backup"; die "$zf is not writable by $(id -un) — run: sudo grove unpublish"; }
		cat "$new" > "$zf"
	fi

	if ! caddy adapt --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
		cp "$backup" "$zf"; rm -f "$backup"
		die "the edited config does not parse — reverted, and nothing was applied"
	fi
	rm -f "$backup"

	if [ "$removed" -eq 1 ]; then
		ok "removed $zf — nothing was left in it"
	else
		ok "rewrote $zf and the combined config parses"
	fi
}

cmd_unpublish() {
	grove_require_public
	require_tools "caddy:brew install caddy" "awk:check your PATH"

	local promote=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--promote)   promote="${2:-}"; [ -n "$promote" ] || die "--promote needs a project name"; shift 2 ;;
			--promote=*) promote="${1#*=}"; shift ;;
			*) die "unknown option: $1 — usage: grove unpublish [--promote <project>]" ;;
		esac
	done

	printf '\n  %sUnpublish %s from %s%s\n\n' "$C_BOLD" "$PROJECT" "$ZONE" "$C_OFF"

	local zf; zf="$(zone_block_file)" || zf=""

	# In privileged mode the block lives in the machine's Caddyfile and applying means restarting the
	# daemon; both need root. Everything on the rootless path needs none.
	if [ -n "$zf" ] && ! rootless_ready && [ "$(id -u)" -ne 0 ]; then
		die "this machine still needs the privileged path — either run with sudo, or do the one-time setup that removes it (see: grove status)"
	fi

	# Who else is on the zone, from BOTH sources, because they drift apart in practice: a row with no
	# matcher is what a teardown by hand leaves behind, a matcher with no row is what a registry
	# written by root and later rewritten by you leaves behind. Neither is a reason to refuse.
	local others_file="" others_reg="" others=""
	[ -n "$zf" ] && others_file="$(zone_matchers "$zf" | grep -v "^${PROJECT}$")"
	[ -f "$ZONE_REGISTRY" ] && others_reg="$(cut -f1 "$ZONE_REGISTRY" 2>/dev/null | grep -v "^${PROJECT}$")"
	others="$(printf '%s\n%s\n' "$others_file" "$others_reg" | grep -v '^[[:space:]]*$' | sort -u)"

	local mine="no"
	if [ -n "$zf" ]; then
		{ zone_matchers "$zf" | grep -q "^${PROJECT}$"; } && mine="matcher"
		grep -q -- "$HOST_FIRST" "$zf" && mine="matcher"
		[ "$(caddyfile_default_port)" = "$UPSTREAM_PORT" ] && mine="default"
	fi

	local new; new="$(mktemp)" || die "could not create a temp file"
	# shellcheck disable=SC2064
	trap "rm -f '$new' '$new.promoted'" RETURN

	case "$mine" in
	no)
		if [ -n "$zf" ]; then
			warn "the $ZONE block does not route $PROJECT — leaving the proxy alone"
		else
			warn "nothing on this machine serves $ZONE — leaving the proxy alone"
		fi
		;;

	matcher)
		strip_matcher "$zf" "$PROJECT" > "$new"
		apply_zone_edit "$zf" "$new"
		ok "removed the $PROJECT matcher from the $ZONE block"
		;;

	default)
		if [ -z "$others" ]; then
			# Last project AND the default: there is no matcher to strip, the block IS the routing.
			strip_zone_block "$zf" > "$new"
			apply_zone_edit "$zf" "$new"
			ok "removed the whole $ZONE block — $PROJECT was the last project on it"
		else
			# Someone has to become the default, or every name under the zone that is not one of the
			# remaining matchers starts 404ing out of Caddy.
			local candidates picked
			candidates="$(zone_matchers "$zf" | grep -v "^${PROJECT}$" | sort -u)"
			[ -n "$candidates" ] || die "$PROJECT owns the default upstream for $ZONE, and no other project on it has a matcher to promote in its place.
       Still on the zone: $(printf '%s' "$others" | tr '\n' ' ')
       Publish one of them first, or unpublish it too and take the zone down with this one."

			if [ -n "$promote" ]; then
				printf '%s\n' "$candidates" | grep -q "^${promote}$" \
					|| die "cannot promote $promote — it has no matcher in the $ZONE block. One of: $(printf '%s' "$candidates" | tr '\n' ' ')"
				picked="$promote"
			else
				picked="$(printf '%s\n' "$candidates" | head -1)"
			fi

			matcher_as_default "$zf" "$picked" > "$new.promoted"
			[ -s "$new.promoted" ] || die "could not read $picked's block out of $zf — nothing was changed"
			swap_default "$zf" "$new.promoted" > "$new"
			# Its matcher goes only after the promoted copy is safely in the staged content.
			local stripped; stripped="$(mktemp)"
			strip_matcher "$new" "$picked" > "$stripped"
			# The block's own header names the project that first wrote it, which is the one leaving.
			# Left alone it credits a project that is no longer on the zone at all. Only the name is
			# replaced — the sentence carries on past it on the same line.
			sed "s|^\(# ${ZONE} — added by grove for \)${PROJECT}|\1${picked}|" "$stripped" > "$new"
			rm -f "$stripped"

			apply_zone_edit "$zf" "$new"
			ok "removed $PROJECT, and promoted $picked to the zone's default upstream"
			warn "$picked now answers every name under $ZONE that no other project claims"
			if [ "$(printf '%s\n' "$candidates" | wc -l | tr -d ' ')" -gt 1 ] && [ -z "$promote" ]; then
				warn "there were others to choose from — re-run with --promote <project> to pick a different one"
			fi
		fi
		;;
	esac

	# What this project's hostnames do NOW. They do not stop answering: they are unclaimed names under
	# a zone that still has a default upstream, so they fall through to it and serve ANOTHER project's
	# site — the same 200-with-the-wrong-site shape as a matcher that matches nothing. Said out loud
	# here rather than left to be met in a browser.
	if [ "$mine" != "no" ]; then
		local now_default owner=""
		now_default="$(caddyfile_default_port)"
		if [ -n "$now_default" ]; then
			[ -f "$ZONE_REGISTRY" ] && owner="$(awk -F'\t' -v p="$now_default" '$2 == p { print $1; exit }' "$ZONE_REGISTRY")"
			if [ -n "$owner" ]; then
				warn "wt1-${PROJECT}.${ZONE} … wt${GROVE_SLOTS:-5}-${PROJECT}.${ZONE} are unclaimed now, and answer with $owner's site"
			else
				warn "wt1-${PROJECT}.${ZONE} … wt${GROVE_SLOTS:-5}-${PROJECT}.${ZONE} are unclaimed now, and answer with whichever project owns the zone default"
			fi
		fi
	fi

	if [ -f "$ZONE_REGISTRY" ] && cut -f1 "$ZONE_REGISTRY" 2>/dev/null | grep -q "^${PROJECT}$"; then
		if zone_unregister "$PROJECT"; then
			ok "removed $PROJECT from $ZONE_REGISTRY"
		else
			warn "could not update $ZONE_REGISTRY"
		fi
	fi

	if [ "$mine" != "no" ]; then
		if rootless_ready; then
			if caddy reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
				ok "Caddy reloaded over the admin API — no root, no restart, no downtime"
			else
				warn "reload failed; the file is in place and will apply on the next reload"
			fi
		else
			apply_caddy 1
		fi
	fi

	local left; left="$(zone_projects)"
	if [ -n "$left" ]; then
		printf '\n  %-14s %s\n\n' "still on zone" "$left"
		return 0
	fi

	printf '\n'
	ok "$ZONE has no projects left"
	printf '\n  What is left is zone-wide, and outlives any one project:\n'
	printf '    %s\n' "the certificate, ACME account and renew.sh in $CERT_DIR"
	[ -f "$DAEMON_PLIST" ] && printf '    %s\n' "the renewal timer ${DAEMON_LABEL}"
	printf '\n  Remove them with:\n\n'
	printf '      grove unpublish-zone\n\n'
	if [ -f "$DAEMON_PLIST" ]; then
		printf '  That needs no root for the certificate store. Only the LaunchDaemon does — re-run it\n'
		printf '  once with sudo and it finishes the job.\n\n'
	else
		printf '  No root: nothing zone-wide here lives outside your own directories.\n\n'
	fi
	printf '  The wildcard DNS record for %s is yours and is left alone: a wildcard pointing\n' "$ZONE"
	printf '  at a private LAN address serves nothing and costs nothing to keep.\n\n'
}

# The zone-level teardown: the certificate store, the ACME account, the renewal script and the timer.
#
# Only the TIMER needs root, and only because a LaunchDaemon lives in /Library/LaunchDaemons. The
# certificate store does not, despite holding a root-owned renew.log — see the note on that below.
# So this does as much as the privileges it has allow, and names what is left.
cmd_unpublish_zone() {
	grove_require_public
	require_tools "launchctl:macOS only — no systemd support"

	local force=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--force) force=1; shift ;;
			# Named rather than ignored: a mistyped --force would otherwise proceed unforced and die on
			# the interlock, which reads as the interlock being wrong.
			*) die "unknown option: $1 — usage: grove unpublish-zone [--force]" ;;
		esac
	done

	# INTERLOCK, and not a formality. The zone block's `tls` line points into the directory this
	# removes. Deleting the certificate under a block that is still there does nothing visible now and
	# then stops Caddy coming up at the next restart — taking every other project on the machine with
	# it, hours or weeks later, for a reason nothing on screen will connect to this command.
	if grove_caddy_cat | grep -q "$ZONE"; then
		die "the proxy still serves $ZONE — run 'grove unpublish' in each project on it first
       (the zone block's tls line points into $CERT_DIR, so removing it now would break Caddy at its next restart)"
	fi

	local left; left="$(zone_projects)"
	if [ -n "$left" ] && [ "$force" -eq 0 ]; then
		die "$ZONE_REGISTRY still lists: $left
       run 'grove unpublish' in each of those projects first, or --force to remove the zone anyway"
	fi

	# THE TIMER IS THE ONLY PART THAT NEEDS ROOT, so it is the only part gated on it. Run as yourself
	# this removes everything else and names the one step left; run under sudo it does all of it, in
	# the order below. Either way it is idempotent, so the sudo run is a safe second pass.
	local timer_left=0
	if [ "$(id -u)" -eq 0 ]; then
		# BOOTOUT FIRST, THEN THE PLIST — never the other way round. launchctl works from the LABEL, not
		# from the file, so a plist removed first leaves the job loaded until the machine reboots: it goes
		# on firing at 04:17 into a renew.sh that no longer exists, and `launchctl bootout` afterwards has
		# nothing on disk to name.
		if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
			launchctl bootout "system/${DAEMON_LABEL}" 2>/dev/null || true
			local waited=0
			while launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1 && [ "$waited" -lt 30 ]; do
				sleep 1; waited=$((waited + 1))
			done
			if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
				die "the renewal timer is still loaded after 30s — not removing its plist, or it would stay loaded until reboot"
			fi
			ok "unloaded the renewal timer ($DAEMON_LABEL)"
		else
			ok "no renewal timer was loaded for $ZONE"
		fi
		[ -f "$DAEMON_PLIST" ] && rm -f "$DAEMON_PLIST" && ok "removed $DAEMON_PLIST"
	elif launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1 || [ -f "$DAEMON_PLIST" ]; then
		timer_left=1
	else
		ok "no renewal timer to remove for $ZONE"
	fi

	# THE CERTIFICATE STORE NEEDS NO ROOT, despite holding a root-owned renew.log. Removing a file is
	# a write to the DIRECTORY that holds it, not to the file — and this directory is yours. (Checked
	# on the real thing rather than assumed: renaming root's renew.log inside it succeeds as you, and
	# rename and unlink are the same permission.)
	#
	# The only rm -rf in this tool. ZONE is checked literally rather than trusted to be non-empty:
	# without a zone this path is the whole grove data directory, every other zone included.
	[ -n "$ZONE" ] || die "the zone is empty — refusing to remove $REAL_HOME/.local/share/grove/"
	if [ -d "$CERT_DIR" ]; then
		rm -rf "$CERT_DIR" 2>/dev/null
		# CHECKED, not assumed. An unwritable file is no obstacle, but a root-owned SUBDIRECTORY is —
		# `sudo grove cert` on some machine leaves lego's tree owned by root, and rm then leaves the
		# directory standing. Reporting success over that would be a lie with a certificate in it.
		if [ -d "$CERT_DIR" ]; then
			warn "could not remove all of $CERT_DIR — part of it is owned by root (a 'sudo grove cert' at some point)"
			warn "finish it with: sudo rm -rf \"$CERT_DIR\""
		elif [ "$(id -u)" -eq 0 ]; then
			ok "removed $CERT_DIR (certificate, key, ACME account, renew.sh, renew.log)"
		else
			ok "removed $CERT_DIR (certificate, key, ACME account, renew.sh, renew.log) — no root needed"
		fi
	else
		ok "no certificate store at $CERT_DIR"
	fi

	if [ "$timer_left" -eq 1 ]; then
		printf '\n'
		warn "the renewal timer is still installed, and a LaunchDaemon is the one thing here that root owns"
		printf '\n  It now fires nightly into a renew.sh that is gone. Finish with:\n\n'
		printf '      sudo grove unpublish-zone\n\n'
		return 0
	fi

	printf '\n  %s is gone from this machine.\n' "$ZONE"
	printf '  Its wildcard DNS record is untouched — that one is yours, and a wildcard pointing at a\n'
	printf '  private LAN address is harmless to leave in place.\n\n'
}

need() { [ -n "${2:-}" ] || die "usage: grove $1 <worktree>  (grove list shows them)"; }

case "${1:-status}" in
	# --- the public half ---
	status)          cmd_status ;;
	cert)            cmd_cert ;;
	publish|install) cmd_install ;;
	unpublish)       shift; cmd_unpublish "$@" ;;
	unpublish-zone)  shift; cmd_unpublish_zone "$@" ;;

	# The one genuinely root-requiring step, and the only one: a LaunchDaemon lives in
	# /Library/LaunchDaemons, which no unprivileged process can write. Split out from `publish` so
	# rootless mode does not have to give up its whole no-sudo story for it — a zone needs this once,
	# ever, and every project that joins the zone afterwards finds it already running.
	publish-timer)
		grove_require_public
		require_tools "launchctl:macOS only — no systemd support"
		[ -f "$CRT" ] || die "no certificate for $ZONE yet — run (as yourself):  grove cert"
		# REPAIR NEEDS NO ROOT. The daemon lives in /Library/LaunchDaemons, but the script it runs is
		# in your own directory — so once the timer exists, pointing it at a moved binary is an
		# ordinary file write. That matters because the script going stale is the likely failure
		# (grove moves, the project is renamed) while the daemon rarely changes at all.
		if [ -f "$DAEMON_PLIST" ] && launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
			write_renew_script || die "could not write $RENEW_SCRIPT — it is owned by $(stat -f '%Su' "$RENEW_SCRIPT" 2>/dev/null || echo root); re-run with sudo"
			ok "renewal timer for $ZONE is running (${DAEMON_LABEL})"
			ok "refreshed its script — it calls $(grove_binary) for project $MAIN_ROOT"
		else
			[ "$(id -u)" -eq 0 ] || die "installing the timer writes to /Library/LaunchDaemons — run: sudo grove publish-timer"
			install_renew_timer
		fi
		;;

	# --- the worktree half ---
	create)
		grove_create "${2:-manual}" "${3:-HEAD}" || die "could not create the worktree — see $GROVE_LOG_FILE"
		ok "$GROVE_NEW_NAME on branch $GROVE_NEW_BRANCH"
		printf '  %-10s %s\n' "path" "$GROVE_NEW_PATH"
		[ -n "$GROVE_NEW_URL" ] && printf '  %-10s %s\n' "site" "$GROVE_NEW_URL"
		[ -n "$GROVE_NEW_DB" ]  && printf '  %-10s %s\n' "database" "$GROVE_NEW_DB"
		[ -f "$GROVE_NEW_PATH/.grove-provision-pending" ] && \
			printf '  %-10s builds on the first file change (or: grove provision %s)\n' "site" "$GROVE_NEW_NAME"
		;;
	list|ls)         grove_list ;;
	info)            need info "${2:-}"; grove_info "$2" ;;
	shell)           need shell "${2:-}"; shift; name="$1"; shift; grove_shell "$name" "$@" ;;
	provision)       need provision "${2:-}"; grove_provision "$2" ;;
	sync-db|reseed)  need sync-db "${2:-}"; grove_sync_db "$2" ;;
	merge)           need merge "${2:-}"; grove_merge "$2" "${3:-}" ;;
	remove|rm)       need remove "${2:-}"; grove_remove "$2" "${3:-}" ;;
	prune-merged)    grove_prune_merged ;;
	wire)            grove_wire ;;

	# --- the machine-facing half ---
	hook)
		case "${2:-}" in
			create)  hook_create ;;
			remove)  hook_remove ;;
			context) hook_context ;;
			on-edit) hook_on_edit ;;
			*)       die "unknown hook: ${2:-<none>} — one of: create remove context on-edit" ;;
		esac
		;;

	*)       die "unknown command: $1 — try: grove --help" ;;
esac
